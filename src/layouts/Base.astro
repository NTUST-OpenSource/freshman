---
import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/markdown.css';
import '../styles/article.css';
import { DEPTS } from '../lib/depts.mjs';
import { CATEGORIES } from '../content.config';

interface Props {
  title?: string;
  description?: string;
  chrome?: boolean;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  modified?: Date;
}

const {
  title,
  description = '開學前指南，包含選課、住宿、生活、還有更多常見的問題整理。',
  chrome = true,
  noindex = false,
  ogType = 'website',
  modified,
} = Astro.props;

const pageTitle = title ? `${title}｜臺科新生懶人包` : '新生懶人包｜臺灣科技大學新生指南';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const navArticles = chrome
  ? (await getCollection('articles', (e) => !e.data.draft && !e.data.noindex)).sort(
      (a, b) => a.data.order - b.data.order,
    )
  : [];
const navGroups = Object.entries(CATEGORIES)
  .map(([key, cat]) => ({ key, label: cat.label, items: navArticles.filter((a) => a.data.category === key) }))
  .filter((g) => g.items.length > 0);
---

<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <meta name="google-site-verification" content="HTzujumbf6X-a1nulhb1Vqr1xrI8eNTjpLRuoZKUnP4" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="臺科新生懶人包" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="臺科新生懶人包" />
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: '臺科新生懶人包',
        alternateName: [
          '臺灣科技大學新生懶人包',
          '台灣科技大學新生懶人包',
          '臺科大新生懶人包',
          '台科大新生懶人包',
          '台科新生懶人包',
          'NTUST 新生懶人包',
        ],
        url: Astro.site?.toString(),
        inLanguage: 'zh-Hant',
      }).replace(/</g, '\\u003c')}
    />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <ClientRouter />
    <script is:inline>
      document.documentElement.dataset.dept = localStorage.getItem('dept') || 'all';
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要內容</a>
    {
      chrome && (
        <header class="site-header" transition:persist="site-header">
          <nav class="site-header__inner" aria-label="主選單">
            <button
              class="icon-btn navdrawer__btn"
              type="button"
              popovertarget="site-nav"
              aria-label="開啟目錄"
            >
              <span class="icon-btn__icon navdrawer__btn-icon" aria-hidden="true" />
            </button>
            <a class="brand" href="/" data-astro-prefetch="viewport">
              <img class="brand__logo" src="/logo.svg" alt="" width="30" height="31" />
              <span class="brand__text">臺科新生懶人包</span>
            </a>
            <div class="site-header__links">
              <a class="nav-pill" href="/article/start/#%E7%9B%AE%E9%8C%84" data-astro-prefetch="viewport">目錄</a>
              <a class="nav-pill" href="/article/contribute/" data-astro-prefetch="viewport">貢獻</a>
              <div class="dept-picker" id="dept-picker">
                <button
                  class="dept-picker__btn"
                  id="dept-btn"
                  type="button"
                  aria-haspopup="listbox"
                  aria-expanded="false"
                >
                  <span id="dept-btn-label">全部</span>
                  <span class="dept-picker__chev" aria-hidden="true"></span>
                </button>
                <ul class="dept-picker__menu" id="dept-menu" role="listbox" aria-label="系別" hidden>
                  {DEPTS.map((d) => (
                    <li role="option" data-code={d.code} tabindex="-1">
                      {d.label}
                    </li>
                  ))}
                </ul>
                <div class="dept-hint" id="dept-hint" role="status" hidden>
                  <span>選擇系別，看看學長姐們的建議</span>
                  <button class="dept-hint__close" id="dept-hint-close" type="button" aria-label="關閉提示">
                    <span class="dept-hint__close-icon" aria-hidden="true" />
                  </button>
                </div>
              </div>
              <a
                class="icon-btn icon-btn--github"
                href="https://github.com/NTUST-OpenSource/freshman"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="GitHub 專案"
              >
                <span class="icon-btn__icon icon-btn__icon--github" aria-hidden="true" />
              </a>
            </div>
          </nav>
        </header>
      )
    }
    {
      chrome && (
        <div class="navdrawer" id="site-nav" popover>
          <div class="navdrawer__head">
            <p class="navdrawer__title">目錄</p>
            <button
              class="navdrawer__close"
              type="button"
              popovertarget="site-nav"
              popovertargetaction="hide"
              aria-label="關閉目錄"
            >
              <span class="navdrawer__close-icon" aria-hidden="true" />
            </button>
          </div>
          <nav aria-label="文章目錄">
            {navGroups.map((group) => (
              <div class={`navdrawer__group cat-${group.key}`}>
                <p class="navdrawer__group-label">{group.label}</p>
                <ul class="navdrawer__list">
                  {group.items.map((a) => (
                    <li>
                      <a
                        href={`/article/${a.data.slug}/`}
                        data-astro-prefetch="hover"
                        aria-current={Astro.url.pathname === `/article/${a.data.slug}/` ? 'page' : undefined}
                      >
                        {a.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </nav>
        </div>
      )
    }
    <main id="main">
      <slot />
    </main>
    {
      chrome && (
        <footer class="site-footer">
          <p>天大地大臺科大，你滑到底了</p>
        </footer>
      )
    }

    <script>
      import '../scripts/view-transitions';
      import { initDeptPicker, initDeptHint } from '../scripts/dept-picker';
      import { initCascade, initCodeCopy, initYt, initMermaid } from '../scripts/content';

      document.addEventListener('astro:page-load', () => {
        initDeptPicker();
        initDeptHint();
        initCascade();
        initCodeCopy();
        initYt();
        initMermaid();
      });
    </script>
  </body>
</html>
