---
interface Props {
  name: string;
  github?: string;
  email?: string;
  founder?: boolean;
}

const { name, github, email, founder = false } = Astro.props;
---

<li class:list={['person', github && 'person--linked', founder && 'person--founder']}>
  {
    github ? (
      <img
        class="person__avatar"
        src={`https://avatars.githubusercontent.com/${github}?s=160`}
        alt=""
        width="160"
        height="160"
        loading="lazy"
      />
    ) : (
      <span class="person__avatar" aria-hidden="true" />
    )
  }
  <div class="person__id">
    <p class="person__name">{name}</p>
    {
      github && (
        <a
          class="person__gh"
          href={`https://github.com/${github}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          @{github}
        </a>
      )
    }
  </div>
  {founder && <span class="person__tag">Founder</span>}
  {
    email && (
      <a class="person__mail" href={`mailto:${email}`} aria-label={`寄信給 ${name}`}>
        <span class="person__mail-icon" aria-hidden="true" />
      </a>
    )
  }
</li>

<style is:global>
  .people {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14.5rem, 1fr));
    gap: 0.7rem;
    margin-top: 1.2rem;
    list-style: none;
  }

  .person {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    transition: border-color var(--dur) var(--ease), translate var(--dur) var(--ease);
  }

  .person--linked:hover,
  .person:focus-within {
    border-color: var(--line-strong);
    translate: 0 -2px;
  }

  .person__avatar {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--surface);
  }

  .person__id {
    min-width: 0; /* flex child needs it before the handle can ellipsis */
  }

  .person__name {
    font-weight: 700;
    line-height: 1.4;
  }

  /* squared corner badge: only the outer corner follows the card radius */
  .person__tag {
    position: absolute;
    top: 0;
    right: 0;
    padding: 0.2rem 0.5rem;
    border-radius: 0 calc(var(--radius) - 1px) 0 var(--radius-s);
    background: var(--brand);
    color: var(--on-brand);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.4;
  }

  .person__gh {
    display: block;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    color: var(--ink-soft);
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color var(--dur) var(--ease);
  }

  /* stretched to the card, so anywhere outside the mail link opens GitHub */
  .person__gh::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .person:hover .person__gh {
    color: var(--brand);
  }

  .person__mail {
    position: relative; /* lifts the link above the stretched GitHub overlay */
    z-index: 1;
    flex: none;
    align-self: flex-end; /* clears the corner badge */
    display: inline-flex;
    margin-left: auto;
    padding: 0.35rem;
    border-radius: var(--radius-s);
    transition: background var(--dur) var(--ease);
  }

  .person__mail:hover {
    background: color-mix(in oklab, var(--brand) 10%, var(--paper));
  }

  .person__mail-icon {
    width: 1.05rem;
    height: 1.05rem;
    background: var(--ink-soft);
    mask: url('/icons/send.svg') no-repeat center / contain;
    -webkit-mask: url('/icons/send.svg') no-repeat center / contain;
    transition: background var(--dur) var(--ease);
  }

  .person__mail:hover .person__mail-icon {
    background: var(--brand);
  }

  .person--founder {
    border-color: color-mix(in oklab, var(--brand) 35%, var(--line));
    background: color-mix(in oklab, var(--brand) 5%, var(--paper));
  }
</style>
