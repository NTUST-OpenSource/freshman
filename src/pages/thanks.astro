---
import Base from '../layouts/Base.astro';
import PersonCard from '../components/PersonCard.astro';
import credits from '../data/credits.json';

const REPO = 'NTUST-OpenSource/freshman';

type Contributor = {
  login: string;
  html_url: string;
  contributions: number;
  type: string;
};

async function fetchContributors(): Promise<Contributor[]> {
  const token = process.env.GITHUB_TOKEN;
  const res = await fetch(`https://api.github.com/repos/${REPO}/contributors?per_page=100`, {
    headers: {
      accept: 'application/vnd.github+json',
      ...(token ? { authorization: `Bearer ${token}` } : {}),
    },
  });
  if (!res.ok) throw new Error(`GitHub API ${res.status} ${res.statusText}`);
  const list: Contributor[] = await res.json();
  return list
    .filter((c) => c.type !== 'Bot' && !c.login.endsWith('[bot]'))
    .sort((a, b) => b.contributions - a.contributions || a.login.localeCompare(b.login));
}

let contributors: Contributor[] = [];
try {
  contributors = await fetchContributors();
} catch (err) {
  console.warn(`[thanks] contributor list unavailable, the grid is omitted: ${err}`);
}
---

<Base
  title="銘謝"
  description="臺科新生懶人包的創辦人、原始貢獻者與 GitHub 貢獻者名單。"
>
  <div class="thanks" data-cascade>
    <header class="thanks__head">
      <h1 class="thanks__h1">銘謝</h1>
    </header>

    {/* Cloudflare rewrites mailto links and its decoder is blocked by the CSP, leaving [email protected] */}
    <Fragment set:html="<!--email_off-->" />

    <section class="thanks__section">
      <h2 class="thanks__h2">創辦人</h2>
      <ul class="people people--single">
        <PersonCard {...credits.founder} />
      </ul>
    </section>

    <section class="thanks__section">
      <h2 class="thanks__h2">原始貢獻者</h2>
      <ul class="people">
        {credits.contributors.map((p) => <PersonCard {...p} />)}
      </ul>
    </section>

    <Fragment set:html="<!--/email_off-->" />

    <section class="thanks__section">
      <h2 class="thanks__h2">GitHub 貢獻者</h2>
      <p class="thanks__note">
        依貢獻數排序，詳情請見
        <a href="/article/contribute/">如何貢獻</a>
      </p>
      {
        contributors.length > 0 && (
          <ul class="gh">
            {contributors.map((c) => (
              <li>
                <a class="gh__item" href={c.html_url} target="_blank" rel="noopener noreferrer">
                  <img
                    class="gh__avatar"
                    src={`https://avatars.githubusercontent.com/${c.login}?s=160`}
                    alt=""
                    width="160"
                    height="160"
                    loading="lazy"
                  />
                  <span class="gh__login">{c.login}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </div>
</Base>

<style is:global>
  .thanks {
    max-width: 62rem;
    margin-inline: auto;
    padding: clamp(2.5rem, 6vh, 4.5rem) 1.25rem 2rem;
  }

  .thanks__head {
    margin-bottom: 2.6rem;
  }

  .thanks__h1 {
    font-size: var(--text-h1);
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .thanks__section + .thanks__section {
    margin-top: 3rem;
  }

  .thanks__h2 {
    font-size: var(--text-h2);
    font-weight: 700;
  }

  .thanks__note {
    margin-top: 0.7rem;
    max-width: var(--measure);
    color: var(--ink-soft);
    font-size: var(--text-small);
    line-height: 1.85;
  }

  /* ---- GitHub contributor grid ---- */
  .gh {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.4rem;
    list-style: none;
  }

  .gh__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    width: 6.5rem;
    padding: 0.9rem 0.4rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--dur) var(--ease), background var(--dur) var(--ease);
  }

  .gh__item:hover {
    border-color: var(--line);
    background: var(--surface);
  }

  .gh__avatar {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--surface);
  }

  .gh__login {
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }


  @media (max-width: 40rem) {
    .gh__item {
      width: 5.5rem;
      padding: 0.7rem 0.3rem;
    }

    .gh__avatar {
      width: 3rem;
      height: 3rem;
    }
  }
</style>

