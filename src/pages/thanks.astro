---
import Base from '../layouts/Base.astro';
import credits from '../data/credits.json';

const REPO = 'NTUST-OpenSource/freshman';
const repoUrl = `https://github.com/${REPO}`;

type Contributor = {
  login: string;
  html_url: string;
  avatar_url: string;
  contributions: number;
  type: string;
};

async function fetchContributors(): Promise<Contributor[]> {
  const token = process.env.GITHUB_TOKEN;
  const res = await fetch(`https://api.github.com/repos/${REPO}/contributors?per_page=100`, {
    headers: {
      accept: 'application/vnd.github+json',
      ...(token ? { authorization: `Bearer ${token}` } : {}),
    },
  });
  if (!res.ok) throw new Error(`GitHub API ${res.status} ${res.statusText}`);
  const list: Contributor[] = await res.json();
  return list
    .filter((c) => c.type !== 'Bot' && !c.login.endsWith('[bot]'))
    .sort((a, b) => b.contributions - a.contributions || a.login.localeCompare(b.login));
}

const avatarOf = (avatarUrl: string) => {
  const url = new URL(avatarUrl);
  url.searchParams.set('s', '160');
  return url.toString();
};

let contributors: Contributor[] = [];
try {
  contributors = await fetchContributors();
} catch (err) {
  console.warn(`[thanks] contributor list unavailable, falling back to the repo link: ${err}`);
}
---

<Base
  title="銘謝"
  description="臺科新生懶人包的創辦人、原始貢獻者與 GitHub 貢獻者名單。"
>
  <div class="thanks">
    <header class="thanks__head">
      <h1 class="thanks__h1">銘謝</h1>
    </header>

    <section class="thanks__section">
      <h2 class="thanks__h2">創辦人</h2>
      <div class="person person--founder">
        <p class="person__name">
          {credits.founder.name}
          {credits.founder.alias && <span class="person__alias">aka {credits.founder.alias}</span>}
        </p>
        <p class="person__links">
          {credits.founder.site && (
            <a href={credits.founder.site} target="_blank" rel="noopener noreferrer">個人網站</a>
          )}
          {credits.founder.github && (
            <a href={`https://github.com/${credits.founder.github}`} target="_blank" rel="noopener noreferrer">
              @{credits.founder.github}
            </a>
          )}
        </p>
      </div>
    </section>

    <section class="thanks__section">
      <h2 class="thanks__h2">原始貢獻者</h2>
      <ul class="people">
        {
          credits.contributors.map((p) => (
            <li class="person">
              <p class="person__name">{p.name}</p>
              <p class="person__links">
                {p.site && (
                  <a href={p.site} target="_blank" rel="noopener noreferrer">個人網站</a>
                )}
                {p.github && (
                  <a href={`https://github.com/${p.github}`} target="_blank" rel="noopener noreferrer">
                    @{p.github}
                  </a>
                )}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="thanks__section">
      <h2 class="thanks__h2">GitHub 貢獻者</h2>
      <p class="thanks__note">
        名單依貢獻數排序，每次網站建置時自動更新。想讓自己的名字出現在這裡，看
        <a href="/article/contribute/">如何貢獻</a>。
      </p>
      {
        contributors.length > 0 && (
          <ul class="gh">
            {contributors.map((c) => (
              <li>
                <a class="gh__item" href={c.html_url} target="_blank" rel="noopener noreferrer">
                  <img
                    class="gh__avatar"
                    src={avatarOf(c.avatar_url)}
                    alt=""
                    width="160"
                    height="160"
                    loading="lazy"
                  />
                  <span class="gh__login">{c.login}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <a class="thanks__repo" href={repoUrl} target="_blank" rel="noopener noreferrer">
        {REPO}
      </a>
    </section>
  </div>
</Base>

<style is:global>
  .thanks {
    max-width: 62rem;
    margin-inline: auto;
    padding: clamp(2.5rem, 6vh, 4.5rem) 1.25rem 2rem;
  }

  .thanks__head {
    margin-bottom: 2.6rem;
  }

  .thanks__h1 {
    font-size: var(--text-h1);
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .thanks__section + .thanks__section {
    margin-top: 3rem;
  }

  .thanks__h2 {
    font-size: var(--text-h2);
    font-weight: 700;
  }

  .thanks__note {
    margin-top: 0.7rem;
    max-width: var(--measure);
    color: var(--ink-soft);
    font-size: var(--text-small);
    line-height: 1.85;
  }

  /* ---- founder and original contributors ---- */
  .people {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr));
    gap: 0.7rem;
    margin-top: 1.2rem;
    list-style: none;
  }

  .person {
    padding: 0.85rem 1rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    transition: border-color var(--dur) var(--ease), translate var(--dur) var(--ease);
  }

  .person:hover {
    border-color: var(--line-strong);
    translate: 0 -2px;
  }

  .person--founder {
    max-width: 20rem;
    margin-top: 1.2rem;
    border-color: color-mix(in oklab, var(--brand) 30%, var(--line));
    background: color-mix(in oklab, var(--brand) 4%, var(--paper));
  }

  .person__name {
    font-weight: 700;
    line-height: 1.5;
  }

  .person--founder .person__name {
    font-size: var(--text-h3);
    color: var(--brand);
  }

  .person__alias {
    margin-left: 0.45rem;
    font-size: var(--text-tiny);
    font-weight: 500;
    color: var(--ink-soft);
  }

  .person__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.7rem;
    margin-top: 0.35rem;
    font-size: var(--text-tiny);
  }

  .person__links a {
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }

  .person__links a:hover {
    color: var(--brand);
    border-color: var(--brand);
  }

  /* ---- GitHub contributor grid ---- */
  .gh {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.4rem;
    list-style: none;
  }

  .gh__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    width: 6.5rem;
    padding: 0.9rem 0.4rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--dur) var(--ease), background var(--dur) var(--ease);
  }

  .gh__item:hover {
    border-color: var(--line);
    background: var(--surface);
  }

  .gh__avatar {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--surface);
  }

  .gh__login {
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .thanks__repo {
    display: inline-block;
    margin-top: 1.4rem;
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    color: var(--ink-soft);
  }

  @media (max-width: 40rem) {
    .gh__item {
      width: 5.5rem;
      padding: 0.7rem 0.3rem;
    }

    .gh__avatar {
      width: 3rem;
      height: 3rem;
    }
  }
</style>

<script>
  // 與文章頁同一套逐塊淡入（.md-cascade 定義在 article.css），不等捲動
  function initThanksCascade() {
    const blocks = document.querySelectorAll<HTMLElement>('.thanks > *');
    if (!blocks.length) return;
    let i = 0;
    for (const block of blocks) {
      if (block.classList.contains('md-cascade')) continue;
      block.classList.add('md-cascade');
      block.style.transitionDelay = `${Math.min(i * 45, 400)}ms`;
      i++;
    }
    requestAnimationFrame(() =>
      requestAnimationFrame(() => {
        for (const block of blocks) block.classList.add('md-cascade--in');
        setTimeout(() => {
          for (const block of blocks) block.style.transitionDelay = '';
        }, 1000);
      }),
    );
  }

  document.addEventListener('astro:page-load', initThanksCascade);
</script>
